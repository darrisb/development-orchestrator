# --- Infrastructure -------------------------------------------------------
DATABASE_URL=postgresql+psycopg://orchestrator:orchestrator@localhost:5432/orchestrator
ARTIFACT_ROOT=./data
# Concern 57. PostgreSQL waits for a lock forever by default, so an abandoned
# request holding a row could park every later one -- including the health
# check. The first bounds a waiter, the second ends a connection left idle
# inside a transaction. Model/reviewer calls are always made after committing
# and releasing the transaction; do not raise this value to match a provider
# timeout as a substitute for that boundary. Zero restores the unbounded
# default for either.
DB_LOCK_TIMEOUT_SECONDS=30
DB_IDLE_IN_TRANSACTION_TIMEOUT_SECONDS=300

# --- Local coder model (OpenAI-compatible; llama.cpp server) --------------
DEFAULT_LOCAL_MODEL_BASE_URL=http://192.168.0.126:8080/v1
DEFAULT_LOCAL_MODEL=m4ven/Qwen3-Coder-30B-A3B-Instruct-Q3_K_M-GGUF:Q3_K_M
# Served context window, not the 262144 the model was trained on. The context
# builder budgets against this.
LOCAL_MODEL_CONTEXT_WINDOW=32768
LOCAL_MODEL_TIMEOUT_SECONDS=600

# --- OpenAI API -----------------------------------------------------------
# Used by registered OpenAI-compatible models that specify
# {"api_key_env": "OPENAI_API_KEY"} in their model metadata.
# Keep the actual key only in .env. Never store API keys in model metadata.
OPENAI_API_KEY=

# --- Reviewer -------------------------------------------------------------
REVIEW_PROVIDER=openai_compatible
REVIEW_BASE_URL=
REVIEW_MODEL=
# Read from the environment only. A registered model in the database stores
# the *name* of a variable like this one, never a key itself.
REVIEW_API_KEY=
REVIEW_TIMEOUT_SECONDS=300
# The reviewer's served context window, and how much of it one review package
# may occupy. Zero derives the window from the coder's, which is usually an
# underestimate for a stronger reviewer.
REVIEW_CONTEXT_WINDOW=0
REVIEW_MAX_PACKAGE_TOKENS=0
REVIEW_PACKAGE_SHARE=0.6
# Everything else in a package is shed before the diff is clipped below this.
REVIEW_MIN_DIFF_TOKENS=3000
# Mask secrets in the review package before it is sent (section 36). Leave it
# unset for "on unless REVIEW_BASE_URL is on this machine", which is the safe
# default: the package carries the raw diff and the raw contents of supporting
# files. Masking costs the reviewer the ability to comment on a masked line, so
# setting it explicitly -- either way -- is an operator's call, not a run's.
# REVIEW_REDACT_PACKAGE=true

# --- Human approval policy (section 37) -----------------------------------
# A reviewer less sure than this does not get to approve on its own. It never
# works the other way: confidence cannot clear the gate below. Zero disables.
# Optional self-reported-confidence gate. Zero disables it; prefer measured
# verification and risk policy unless the reviewer has been calibrated.
REVIEW_MIN_CONFIDENCE=0
FIX_LOOP_STAGNANT_REVIEW_LIMIT=2
FIX_LOOP_FEEDBACK_HISTORY_LIMIT=3
TRAINING_MAX_CAPTURED_PER_PROJECT=500
# Section 37's "deleting significant files".
REVIEW_MAX_DELETED_FILES=3
# Turning this off accepts changes to authentication, payments, migrations,
# CI/CD and dependencies without a human. It exists for a sandbox project.
REVIEW_HUMAN_APPROVAL_ENABLED=true

# --- Git policy -----------------------------------------------------------
GIT_PUSH_ENABLED=false
GIT_PUSH_REMOTE=origin
# Force-pushing and starting on top of uncommitted local changes are both
# deliberate operator decisions; neither is ever taken by a run itself.
GIT_FORCE_PUSH_ENABLED=false
GIT_ALLOW_DIRTY_START=false
GIT_AUTHOR_NAME=AI Orchestrator
GIT_AUTHOR_EMAIL=orchestrator@localhost
GIT_COMMAND_TIMEOUT_SECONDS=120
# Task worktrees are created only beneath this directory.
WORKTREE_ROOT=./workspace/worktrees
# Set only when the orchestrator runs in a container and talks to the host
# Docker daemon. It must name the host-side directory bind-mounted above.
# HOST_WORKTREE_ROOT=/absolute/host/path/to/workspace/worktrees

# --- Context builder ------------------------------------------------------
# 0 derives the ceiling from LOCAL_MODEL_CONTEXT_WINDOW * CONTEXT_WINDOW_SHARE,
# which keeps the budget tied to the endpoint that will serve the prompt.
CONTEXT_MAX_TOKENS=0
CONTEXT_WINDOW_SHARE=0.45
CONTEXT_MAX_ITEM_TOKENS=2000
CONTEXT_MAX_FILES=40
CONTEXT_MAX_FILE_BYTES=262144
# Concern 62: absolute growth allowance for a complete writable file. Added to
# the source size and the proportional headroom to give medium files room for
# legitimate additions beyond proportional growth.
CONTEXT_ABSOLUTE_GROWTH_ALLOWANCE_BYTES=2500
CONTEXT_MAX_DECISIONS=5
CONTEXT_MAX_LESSONS=5
CONTEXT_RECENT_COMMITS=5
CONTEXT_MAP_MAX_ENTRIES=300

# --- Worker runtime (sections 11 and 12) ----------------------------------
# docker | subprocess   (subprocess is a development fallback with weaker isolation)
WORKER_BACKEND=docker
# Whole-run ceiling, and the per-command ceiling that kills a hanging suite
# long before the run gives up.
WORKER_TIMEOUT_SECONDS=1800
WORKER_COMMAND_TIMEOUT_SECONDS=900
# Per-stream capture ceiling. Output past it is clipped with a visible marker.
WORKER_MAX_OUTPUT_BYTES=1000000
# Build these with ./scripts/dev.sh workers
WORKER_NODE_IMAGE=orchestrator-worker-node:latest
WORKER_JAVA_IMAGE=orchestrator-worker-java:latest
WORKER_PYTHON_IMAGE=orchestrator-worker-python:latest
# Restricted network by default. `none` means a verification command cannot
# install dependencies: the repository must already have them. Anything else
# here is a deliberate decision to let project code reach the network.
WORKER_NETWORK=none
WORKER_CPUS=2.0
WORKER_MEMORY=4g
WORKER_PIDS_LIMIT=512
# uid:gid for the container. Empty means "the orchestrator's own user", which
# keeps files the worker writes into the worktree host-owned.
WORKER_USER=
# Executables a project needs beyond its profile's list, comma-separated. This
# never overrides the never-permitted list (sudo, docker, curl, git, ...).
WORKER_EXTRA_EXECUTABLES=
# Permit ./script.sh-style verification commands. A repository script is
# arbitrary code, and a coder that may edit a permitted script has a shell.
WORKER_ALLOW_RELATIVE_SCRIPTS=false
# Non-secret host variables to pass into a worker, comma-separated. A
# credential-shaped name is refused; secrets are injected per run instead.
WORKER_ENV_PASSTHROUGH=
# Keep a failed worker's container for inspection. Leaks containers by design.
WORKER_RETAIN_ON_FAILURE=false
DOCKER_BINARY=docker

# --- Service --------------------------------------------------------------
LOG_LEVEL=INFO
